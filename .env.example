# ---- Postgres ----
POSTGRES_USER=pf
POSTGRES_PASSWORD=pf
POSTGRES_DB=pf_audit

# ---- Backend ----
# для локального запуска backend вне docker используйте localhost вместо postgres/redis
DATABASE_URL=postgresql://pf:pf@localhost:5432/pf_audit?schema=public
REDIS_HOST=localhost
REDIS_PORT=6379
JWT_SECRET=change-me
PORT=3000

# ---- Внешние API ----
# Yandex Search API v2 (Yandex Cloud): позиции в выдаче. https://yandex.cloud/ru/docs/search-api/
YANDEX_SEARCH_API_KEY=
YANDEX_SEARCH_FOLDER_ID=

# Google PageSpeed Insights (LCP/FCP/TTFB). https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=

# Yandex Wordstat API (частотность). https://yandex.ru/dev/wordstat/
WORDSTAT_OAUTH_TOKEN=

# Конкуренты — достаточно одного провайдера
SERPSTAT_API_KEY=
KEYSSO_API_KEY=
AHREFS_API_TOKEN=

# ---- Embeddings микросервис ----
EMBEDDINGS_URL=http://localhost:8000
EMBEDDINGS_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# ---- Frontend ----
VITE_API_URL=http://localhost:3000/api

# ---- Краулер аудита ----
CRAWLER_USER_AGENT=PF-SiteAudit/1.0 (+https://pf.sites-s.ru/bot)
CRAWLER_MAX_PAGES=15
CRAWLER_MAX_DEPTH=3
CRAWLER_DELAY_MS=1500
CRAWLER_CONCURRENCY=2
