<?xml version="1.0" encoding="utf-8"?>
<!-- phones before Android 8: the winged shield on a rounded night-blue square, the owner's portrait over it when the
     server has put one in (see ic_launcher_face.xml) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape android:shape="rectangle"><corners android:radius="22dp" />
        <gradient android:startColor="#0B1026" android:centerColor="#1E1B4B" android:endColor="#0F3D4C" android:angle="315" /></shape></item>
    <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp" android:drawable="@drawable/emblem" />
    <item android:drawable="@drawable/ic_owner" />
</layer-list>
