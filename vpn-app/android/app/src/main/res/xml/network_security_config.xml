<?xml version="1.0" encoding="utf-8"?>
<!-- encrypted connections only, except the tiny response-time check (an empty page, nothing private) -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">cp.cloudflare.com</domain>
    </domain-config>
    <!-- the VK bridge's «I am not a robot» page: the bridge program's own, on this phone -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
