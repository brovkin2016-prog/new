{
  "env": {
    "BASH_MAX_OUTPUT_LENGTH": "15000",
    "IMPECCABLE_NO_TELEMETRY": "1",
    "DO_NOT_TRACK": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "DISABLE_FEEDBACK_COMMAND": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1"
  },
  "permissions": {
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(rm -rf /:*)",
      "Bash(curl * | sh:*)",
      "Bash(curl * | bash:*)",
      "Bash(wget * | sh:*)",
      "Bash(sudo:*)",
      "Bash(chmod 777:*)",
      "Bash(ssh:*)",
      "Read(./server/release/*.enc)",
      "Read(./**/package-lock.json)",
      "Read(./.claude/skills/impeccable/scripts/data/font-index.json)",
      "Read(./.claude/skills/hallmark/scripts/photos.json)"
    ]
  },
  "feedbackSurveyRate": 0,
  "feedbackDrafts": "off"
}
